# Dependencies and builds
node_modules/
dist/
.vite/

# Secrets: app/.env.local holds the webhook URL and auth
.env.local
.env.*.local
.env*.bak

# Logs and runtime files (delivery log, ab log, tombstones, lock dirs)
*.log
*.jsonl
*.lock

# Local output: e2e screenshots and runs, board backups
runs/
backups/
screenshots/
*.png

.DS_Store
runs/*.json
runs/*.log
.env*.bak
app/.delivery-log.jsonl
app/.ab-log.jsonl
app/.ab-cleared.jsonl
app/.pr-feed.json
app/.pr-feed.json.*.tmp
desktop/.userdata/
/data/

# README screenshots are committed on purpose (example data only)
!docs/screenshots/
!docs/screenshots/*.png

# Generated from the checked-in desktop icon source
!desktop/icon/icon.png
