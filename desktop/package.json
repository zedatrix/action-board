{
  "name": "action-board-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron companion for Action Board",
  "main": "main.js",
  "scripts": {
    "test": "node --test --test-isolation=none \"test/*.test.js\"",
    "start": "electron .",
    "icon": "node icon/make-icon.js",
    "package": "electron-packager . \"Action Board\" --platform=darwin --arch=arm64 --out=dist --overwrite --icon=icon/icon.icns --app-bundle-id=com.actionboard.app.desktop --ignore=\"^/node_modules\" --ignore=\"^/dist\" --ignore=\"^/test\" --ignore=\"^/icon/(action-board-icon.svg|make-icon.js|icon.icns)$\" --ignore=\"^/\\.userdata\" && npm run sign",
    "sign": "codesign --force --deep --sign - \"dist/Action Board-darwin-arm64/Action Board.app\" && codesign --force --sign - --identifier com.actionboard.app.desktop \"dist/Action Board-darwin-arm64/Action Board.app\" && codesign --verify --deep --strict \"dist/Action Board-darwin-arm64/Action Board.app\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.5.0"
  }
}
