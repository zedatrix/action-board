# Copy to app/.env.local (start.sh does this once) and fill in. Never commit .env.local.
# Restart the board after any change here.

# Where the board POSTs in-app answers, notes, "Explain this better" and "Not relevant anymore".
ACTION_BOARD_WEBHOOK_URL=
# Sent as the Authorization header on every POST, exactly as written (for example: Bearer <token>).
ACTION_BOARD_WEBHOOK_AUTH=

# The assistant's name shown in the UI. Default: your assistant
ACTION_BOARD_ASSISTANT_NAME=
# IANA time zone for card times. Default: America/New_York
ACTION_BOARD_TIMEZONE=
# Host name the board answers on, besides localhost and 127.0.0.1. Default: board.localhost
ACTION_BOARD_HOST=
# Port. Default: 8085
ACTION_BOARD_PORT=
